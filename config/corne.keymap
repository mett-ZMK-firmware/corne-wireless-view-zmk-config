#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt { tapping-term-ms = <140>; };

&mmv { delay-ms = <200>; };

/ {
    macros {
        CAD: CAD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(DEL))>;
            label = "CAD";
        };

#include "secret_macros.dtsi"
    };

    behaviors {
        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold for momentary and tap for toggle";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        hr_mt: hr_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "Home row hold tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB        &kp Q  &kp W  &kp E         &kp R        &kp T        &kp Y    &kp U           &kp I               &kp O    &kp P     &kp BSPC
&mt LCTRL ESC  &kp A  &kp S  &kp D         &kp F        &kp G        &kp H    &hr_mt RCTRL J  &hr_mt RIGHT_ALT K  &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C         &kp V        &kp B        &kp N    &kp M           &kp COMMA           &kp DOT  &kp FSLH  &kp RSHIFT
                             &kp LEFT_ALT  &mo_tog 2 1  &kp SPACE    &kp RET  &mo_tog 3 3     &kp LEFT_GUI
            >;
        };

        navi_layer {
            display-name = "Navi";
            bindings = <
&kp GRAVE  &trans  &msc SCRL_UP    &mmv MOVE_UP    &mkp MB1         &trans        &trans            &kp PAGE_UP    &kp UP    &kp HOME   &kp BSLH  &kp DEL
&trans     &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp C_MUTE    &kp C_PLAY_PAUSE  &kp LEFT       &kp DOWN  &kp RIGHT  &kp LBKT  &kp RBKT
&trans     &trans  &msc SCRL_DOWN  &mkp MB3        &mkp MB2         &kp C_PREV    &kp C_NEXT        &kp PAGE_DOWN  &kp INS   &kp END    &trans    &trans
                                   &trans          &to 0            &trans        &trans            &to 0          &trans
            >;
        };

        macro_layer {
            display-name = "Macro";
            bindings = <
&kp GRAVE  &kp LC(F1)  &msc SCRL_UP    &mmv MOVE_UP    &mkp MB1         &kp LA(F4)    &PW               &kp PAGE_UP    &kp UP    &kp HOME   &kp BSLH  &kp DEL
&trans     &kp CAPS    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp C_MUTE    &kp C_PLAY_PAUSE  &kp LEFT       &kp DOWN  &kp RIGHT  &kp LBKT  &kp RBKT
&trans     &trans      &msc SCRL_DOWN  &mkp MB3        &mkp MB2         &kp C_PREV    &kp C_NEXT        &kp PAGE_DOWN  &kp INS   &kp END    &trans    &trans
                                       &trans          &trans           &trans        &trans            &to 4          &trans
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp GRAVE  &trans  &kp N7  &kp N8  &kp N9  &kp N0       &trans  &kp F7           &kp F8               &kp F9  &kp F10  &kp F11
&trans     &trans  &kp N4  &kp N5  &kp N6  &kp MINUS    &trans  &hr_mt RCTRL F4  &hr_mt RIGHT_ALT F5  &kp F6  &trans   &kp F12
&trans     &trans  &kp N1  &kp N2  &kp N3  &kp EQUAL    &trans  &kp F1           &kp F2               &kp F3  &trans   &trans
                           &trans  &to 0   &trans       &trans  &to 0            &trans
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
&bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &none  &none  &none    &studio_unlock  &none  &none  &none  &none  &none
&none       &none       &none       &none  &none  &none    &none           &none  &none  &none  &none  &none
&none       &none       &none       &none  &none  &none    &none           &none  &none  &none  &none  &none
                                    &none  &to 0  &none    &none           &to 0  &none
            >;
        };
    };
};
